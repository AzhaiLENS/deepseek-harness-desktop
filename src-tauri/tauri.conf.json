{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Desktop 测试版",
  "mainBinaryName": "dsh-desktop",
  "version": "0.1.0",
  "identifier": "ai.deepseek.harness.desktop.test",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "splash",
        "title": "DeepSeek Harness",
        "width": 620,
        "height": 420,
        "resizable": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness desktop application",
    "longDescription": "A standalone desktop shell for DeepSeek Harness (dsh): it ships its own Node.js runtime and a vendored DSH installation, and embeds the Harness web UI in a native window. Nothing has to be installed on the user's machine, and DSH's own update path keeps working.",
    "copyright": "MIT",
    "resources": ["payload"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "allowDowngrades": false
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
